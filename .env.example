# =============================================================================
# Clinic Growth OS — environment (MASTER_PROMPT §36, §58)
# Copy to .env.local. NEVER commit a filled-in copy. NEVER use production
# secrets locally (§58). No variable here may be prefixed NEXT_PUBLIC_ (§53).
# =============================================================================

# --- Database (§4.1, §9.1) ---------------------------------------------------
# DATABASE_URL           -> role clinic_os_app. Owns nothing, cannot run DDL.
#                           This is what the application connects as.
# DATABASE_URL_UNPOOLED  -> owner role. Migrations and test fixtures only.
#                           Never used to serve a request.
DATABASE_URL=postgresql://clinic_os_app:CHANGE_ME@localhost:5432/clinic_os
DATABASE_URL_UNPOOLED=postgresql://postgres:CHANGE_ME@localhost:5432/clinic_os

# --- Platform (§10) ----------------------------------------------------------
PLATFORM_ROOT_DOMAIN=localhost:3000

# --- Deferred: required from the milestone that implements each provider ------
# Better Auth (M2, §4.3) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (M7, §4.2, §37) — secret key must never reach the browser
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Custom domains (M3, §36) — server-side only.
#
# MASTER_PROMPT §36 calls these VERCEL_API_TOKEN / VERCEL_PROJECT_ID /
# VERCEL_TEAM_ID. Those exact names are unusable: Vercel reserves the VERCEL_
# prefix for its own system variables and rejects any project variable starting
# with it, so setting them in the Vercel dashboard fails. Named by role instead,
# which also matches the §46 provider abstraction.
DOMAIN_PROVIDER_TOKEN=
DOMAIN_PROVIDER_PROJECT_ID=
DOMAIN_PROVIDER_TEAM_ID=
